# Navic vendors two libraries as Git submodules. This file lives at the repo
# root (not only in Navic/) so `git submodule update --init --recursive` and the
# GitHub Actions checkout can fill them; without it a CI build has empty
# vendor folders and Gradle fails.
[submodule "Navic/vendor/androidx-media"]
	path = Navic/vendor/androidx-media
	url = https://github.com/Nightdavisao/android-media3
[submodule "Navic/vendor/subsonic-kotlin"]
	path = Navic/vendor/subsonic-kotlin
	url = https://github.com/Nightdavisao/subsonic-kotlin
